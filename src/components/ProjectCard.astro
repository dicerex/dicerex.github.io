---
import { type Project, projectEnglish, engagements } from '../data/projects';
import T from './T.astro';
import ProjectArt from './ProjectArt.astro';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const en = projectEnglish[project.slug];
const engagement = engagements[project.engagement];
---
<article id={`project-${project.slug}`} class="project-card" data-category={project.category === 'Приложения' ? 'apps' : 'websites'}>
  <div class="project-information">
    <div class="project-meta"><span class="mono">{String(index + 1).padStart(2, '0')} / <T ru={project.kind} en={en.kind} /></span></div>
    <h3><T ru={project.name} en={en.name} /></h3>
    <p class="project-attribution"><T ru={engagement.ru} en={engagement.en} /></p>
    <p class="project-description"><T ru={project.description} en={en.description} /></p>
    <div class="project-contribution"><p class="eyebrow"><T k="contribution" /></p><p><T ru={project.contribution} en={en.contribution} /></p></div>
    {project.website && <a class="project-live-link" href={project.website} target="_blank" rel="noopener noreferrer"><T k="visitWebsite" /><span aria-hidden="true">↗</span></a>}
    <details class="project-details" id={`details-${project.slug}`}><summary><T k="details" /><span aria-hidden="true">+</span></summary><div class="project-details-body">
      <ul class="tags" aria-label="Технологии" data-en-aria-label="Technologies">{project.stack.map(tag => <li>{tag}</li>)}</ul>
      <div class="project-parts">{project.system.map((part, i) => <section><span class="mono">0{i + 1}</span><div><h4><T ru={part.title} en={en.system[i].title} /></h4><p><T ru={part.text} en={en.system[i].text} /></p></div></section>)}</div>
    </div></details>
  </div>
  <ProjectArt project={project} />
</article>
