---
import { type Project, projectEnglish } from '../data/projects';
import T from './T.astro';
interface Props { project: Project }
const { project } = Astro.props;
const en = projectEnglish[project.slug];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shots = project.screenshots ?? [];
const desktopIndex = shots.findIndex(shot => shot.width > shot.height);
const mobileIndex = shots.findIndex(shot => shot.width < shot.height);
const desktop = shots[desktopIndex];
const mobile = shots[mobileIndex];
const isWebsite = Boolean(desktop);
---
<div class="project-media" data-device-preview>
  <div class:list={['device-composition', project.color, { 'is-website': isWebsite, 'is-app': !isWebsite }]} data-device-stage data-focus="mobile">
    {desktop && <button type="button" class="device-desktop" data-gallery={project.slug} data-image-index={desktopIndex} aria-label={`Увеличить снимок: ${desktop.alt.ru}`} data-en-aria-label={`Enlarge screenshot: ${desktop.alt.en}`}><span class="browser-bar" aria-hidden="true"><span class="window-dots">● ● ●</span><span><T ru={project.name} en={en.name} /></span><span>⤢</span></span><img src={`${base}/images/${desktop.src}`} alt={desktop.alt.ru} data-en-alt={desktop.alt.en} width={desktop.width} height={desktop.height} loading="lazy" /></button>}
    {mobile && <><span class="device-watermark" aria-hidden="true">{!isWebsite && project.mark}</span><button type="button" class="device-phone" data-gallery={project.slug} data-image-index={mobileIndex} aria-label={`Увеличить снимок: ${mobile.alt.ru}`} data-en-aria-label={`Enlarge screenshot: ${mobile.alt.en}`}><img src={`${base}/images/${mobile.src}`} alt={mobile.alt.ru} data-en-alt={mobile.alt.en} width={mobile.width} height={mobile.height} loading="lazy" /><span class="device-enlarge" aria-hidden="true">⤢</span></button></>}
    {!shots.length && <span class="empty-art"><T k="diagram" /></span>}
    <span class="device-corner" aria-hidden="true">+</span>
  </div>
  <div class="media-footer">
    {desktop && mobile ? <div class="device-controls" role="group" aria-label="На переднем плане" data-en-aria-label="Bring to front"><button type="button" data-device-focus="desktop" aria-pressed="false"><T k="desktop" /></button><button type="button" data-device-focus="mobile" aria-pressed="true"><T k="phone" /></button></div> : <span class="mono media-type">{isWebsite ? 'WEB' : 'MOBILE APP'}</span>}
    <span class="media-hint"><T k="enlarge" /> <span aria-hidden="true">⤢</span></span>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-device-preview]').forEach(preview => {
    const stage = preview.querySelector<HTMLElement>('[data-device-stage]');
    const buttons = preview.querySelectorAll<HTMLButtonElement>('[data-device-focus]');
    buttons.forEach(button => button.addEventListener('click', () => {
      if (stage) stage.dataset.focus = button.dataset.deviceFocus;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    }));
  });
</script>
