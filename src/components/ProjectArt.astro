---
import { type Project, projectEnglish } from '../data/projects';
import T from './T.astro';
interface Props { project: Project }
const { project } = Astro.props;
const en = projectEnglish[project.slug];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cover = project.screenshots?.[0];
---
<div class:list={['project-art', project.color, { 'has-image': cover, 'mobile-cover': cover && cover.width < cover.height }]}>
  {cover ? cover.width < cover.height ? <><div class="mobile-cover-text"><span class="mono">MOBILE APP</span><strong><T ru={project.name} en={en.name} /></strong><span><T ru={project.kind} en={en.kind} /></span></div><div class="phone-frame"><img src={`${base}/images/${cover.src}`} alt={cover.alt.ru} data-en-alt={cover.alt.en} loading="lazy" width={cover.width} height={cover.height} /></div></> : <div class="browser-frame"><div class="browser-bar"><span class="window-dots">● ● ●</span><span><T ru={project.name} en={en.name} /></span><span>↗</span></div><img src={`${base}/images/${cover.src}`} alt={cover.alt.ru} data-en-alt={cover.alt.en} loading="lazy" width={cover.width} height={cover.height} /></div> : <><span class="art-caption">{project.category === 'Приложения' ? 'PRODUCT SYSTEM' : 'WEB EXPERIENCE'}</span><div class="art-emblem" aria-hidden="true">{project.mark}</div><div class="art-flow" aria-label="Схема продукта" data-en-aria-label="Product diagram">{project.nodes.map((node, i) => <><span><T ru={node} en={en.nodes[i]} /></span>{i < 2 && <b aria-hidden="true">↗</b>}</>)}</div><span class="art-note"><T k="diagram" /></span></>}
</div>
