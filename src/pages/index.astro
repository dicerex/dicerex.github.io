---
import Layout from '../layouts/Layout.astro';
import ProjectArt from '../components/ProjectArt.astro';
import { projects, experiments } from '../data/projects';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpeg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-topline"><p class="eyebrow"><span class="status-dot"></span> NODE.JS / TYPESCRIPT / FULL CYCLE</p><span class="hero-index mono">ПОРТФОЛИО / 2026</span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-heading">От задачи —<br />до <span class="hero-accent">работающего</span><br />продукта<span class="orange">.</span></h1>
        <p class="hero-lead">Я Александр Алексеев. Проектирую серверную часть, связываю системы и довожу приложения до пользователей. В разработке с 2015 года.</p>
        <div class="hero-buttons"><a class="button button-dark" href="#work">Смотреть проекты <span>↘</span></a><a class="text-link" href="https://t.me/fckur" target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a></div>
      </div>
      <aside class="system-card" aria-label="Мой подход к разработке">
        <div class="system-card-head"><span class="mono">СОБИРАЮ В ЦЕЛОЕ</span><span class="system-live" aria-hidden="true">↗</span></div>
        <div class="system-diagram" aria-hidden="true">
          <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span>
          <div class="system-core">{`{ }`}</div>
          <span class="system-node node-one">API</span><span class="system-node node-two">APP</span><span class="system-node node-three">WEB</span><span class="system-node node-four">DATA</span>
          <span class="diagram-cross cross-one">+</span><span class="diagram-cross cross-two">+</span>
        </div>
        <div class="system-card-foot"><span>Логика внутри.<br /> <strong>Польза снаружи.</strong></span><span class="mono">01—∞</span></div>
      </aside>
    </div>
    <div class="hero-bottom"><span>BACKEND ПО ФОКУСУ. ПРОДУКТ ЦЕЛИКОМ — ПО ОПЫТУ.</span><a href="#work" aria-label="Перейти к проектам">↓</a></div>
  </section>

  <section id="work" class="work-section shell" aria-labelledby="work-heading">
    <div class="section-heading"><div><p class="eyebrow section-number">01 / ВЫБРАННЫЕ РАБОТЫ</p><h2 id="work-heading">За интерфейсом —<br />целая система.</h2></div><p class="section-intro">Мобильные продукты и веб-сайты.<br />У каждого — своя задача, аудитория<br class="desktop-break" /> и техническая история.</p></div>
    <div class="work-toolbar"><div class="filters" role="group" aria-label="Фильтр проектов"><button class="filter active" data-filter="all" aria-pressed="true">Все <span>06</span></button><button class="filter" data-filter="Приложения" aria-pressed="false">Приложения <span>03</span></button><button class="filter" data-filter="Веб-сайты" aria-pressed="false">Веб-сайты <span>03</span></button></div><span class="mono work-label">КОММЕРЧЕСКИЕ ПРОЕКТЫ</span></div>
    <div class="project-grid">
      {projects.map((project, index) => <article class="project-card" data-category={project.category}>
        <a href={`${base}/projects/${project.slug}/`} class="project-visual-link" aria-label={`Открыть проект ${project.name}`}><ProjectArt project={project} /><span class="project-open" aria-hidden="true">↗</span></a>
        <div class="project-meta"><span class="mono">{String(index + 1).padStart(2, '0')} / {project.kind}</span><span>{project.category}</span></div>
        <h3><a href={`${base}/projects/${project.slug}/`}>{project.name}<span aria-hidden="true">↗</span></a></h3>
        <p>{project.description}</p>
        <ul class="tags" aria-label="Технологии">{project.stack.slice(0, 4).map(tag => <li>{tag}</li>)}</ul>
      </article>)}
    </div>
    <p class="work-footnote">В проектах без снимков пока показаны схемы состава продукта. Галереи будем дополнять реальными экранами.</p>
    <p class="sr-only" role="status" id="filter-status" aria-live="polite"></p>
  </section>

  <section id="about" class="about-section" aria-labelledby="about-heading"><div class="shell about-grid">
    <div class="about-intro"><p class="eyebrow section-number">02 / ПОДХОД</p><h2 id="about-heading">Вижу задачу<br />шире одного<br /><span>экрана.</span></h2><p>Мой основной интерес — серверная разработка: модели данных, API, бизнес-логика и интеграции. Опыт с мобильными и веб-клиентами помогает видеть, как техническое решение работает для человека.</p><div class="author-signature"><Image src={avatar} alt="Александр Алексеев" width={112} height={112} format="webp" loading="lazy" /><span>Александр Алексеев<small>Иркутск · Работаю удалённо</small></span></div><div class="experience-stamp"><strong>2015<span>→</span></strong><span>начало пути<br />в разработке</span></div></div>
    <div class="approach-list">
      <article><span class="mono">01</span><div><h3>Начинаю с устройства продукта</h3><p>Разбираюсь, кто будет пользоваться системой, какие данные нужны и какие правила должны соблюдаться.</p></div><span class="approach-icon" aria-hidden="true">⌘</span></article>
      <article><span class="mono">02</span><div><h3>Соединяю части в систему</h3><p>Сервер, приложение и административная панель работают вместе. API и интеграции связывают пользовательские сценарии.</p></div><span class="approach-icon" aria-hidden="true">⇄</span></article>
      <article><span class="mono">03</span><div><h3>Довожу до выпуска и поддержки</h3><p>Учитываю окружение, развёртывание и жизнь продукта после первого релиза — включая развитие существующего кода.</p></div><span class="approach-icon" aria-hidden="true">↗</span></article>
    </div>
  </div></section>

  <section class="stack-section shell" aria-labelledby="stack-heading"><div class="stack-title"><p class="eyebrow section-number">03 / ИНСТРУМЕНТЫ</p><h2 id="stack-heading">Стек под задачу.</h2></div><div class="stack-table">
    <div><span class="mono">01 / ОСНОВНОЙ ФОКУС</span><h3>Backend</h3><p>Node.js · TypeScript · Express · NestJS · REST API · WebSocket</p></div>
    <div><span class="mono">02 / ХРАНЕНИЕ И РАЗВЁРТЫВАНИЕ</span><h3>Data & infrastructure</h3><p>PostgreSQL · MySQL · Redis · Docker · Linux · Nginx · CI/CD</p></div>
    <div><span class="mono">03 / ПОЛЬЗОВАТЕЛЬСКАЯ ЧАСТЬ</span><h3>Mobile & web</h3><p>Flutter · Dart · Vue · Nuxt · Capacitor · HTML / CSS</p></div>
  </div></section>

  <section id="lab" class="lab-section shell" aria-labelledby="lab-heading"><div class="section-heading"><div><p class="eyebrow section-number">04 / ЛИЧНЫЕ ПРОЕКТЫ</p><h2 id="lab-heading">Интерес превращаю<br />в код.</h2></div><p class="section-intro">Свои задачи и технические эксперименты.<br />Здесь исследую идеи и пробую подходы.</p></div><div class="lab-list">{experiments.map(item => <article><span class="mono lab-number">{item.number}</span><h3>{item.name}<span>Пет-проект</span></h3><div><p>{item.description}</p><span class="mono lab-tags">{item.tags}</span></div><span class="lab-mark" aria-hidden="true">+</span></article>)}</div><p class="lab-footnote">Биржевые проекты — технические эксперименты. Результаты доходности не заявляются.</p></section>

  <section id="contact" class="contact-section shell" aria-labelledby="contact-heading"><div class="contact-top"><p class="eyebrow">ЕСТЬ ЗАДАЧА ИЛИ ПРЕДЛОЖЕНИЕ?</p><span aria-hidden="true">↗</span></div><h2 id="contact-heading">Давайте соберём<br />что-то <em>работающее.</em></h2><div class="contact-bottom"><a class="button button-dark" href="https://t.me/fckur" target="_blank" rel="noopener noreferrer">Написать в Telegram <span>↗</span></a><a class="contact-email" href="mailto:desidaraiy@gmail.com">desidaraiy@gmail.com</a><span class="mono">ИРКУТСК · УДАЛЁННО</span></div></section>
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(filter => {
      const active = filter === button;
      filter.classList.toggle('active', active);
      filter.setAttribute('aria-pressed', String(active));
    });
    let count = 0;
    cards.forEach(card => {
      const visible = button.dataset.filter === 'all' || card.dataset.category === button.dataset.filter;
      card.hidden = !visible;
      if (visible) count++;
    });
    const status = document.getElementById('filter-status');
    if (status) status.textContent = `Показано проектов: ${count}`;
  }));
</script>
