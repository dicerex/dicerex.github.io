---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lightbox from '../components/Lightbox.astro';
import T from '../components/T.astro';
import { projects, experiments, experimentEnglish } from '../data/projects';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpeg';
---
<Layout>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-topline"><p class="eyebrow"><span class="status-dot"></span><T k="role" /></p><span class="hero-index mono"><T k="edition" /></span></div>
    <div class="hero-grid">
      <div class="hero-copy"><h1 id="hero-heading"><T k="hero" /></h1><p class="hero-lead"><T k="lead" /></p><div class="hero-buttons"><a class="button button-dark" href="#work"><T k="view" /><span>↘</span></a><a class="text-link" href="https://t.me/fckur" target="_blank" rel="noopener noreferrer"><T k="telegram" /> ↗</a></div></div>
      <figure class="hero-portrait"><span class="portrait-kicker mono"><T k="hello" /></span><Image src={avatar} alt="Александр Алексеев" data-en-alt="Alexander Alekseev" widths={[360, 520, 720]} sizes="(max-width: 760px) 88vw, 38vw" width={520} height={520} format="webp" loading="eager" fetchpriority="high" /><figcaption><strong><T k="name" /></strong><span><T k="location" /></span></figcaption><span class="portrait-year mono">2015 — 2026</span></figure>
    </div>
    <div class="hero-bottom"><span><T k="focus" /></span><a href="#work" aria-label="Перейти к проектам" data-en-aria-label="Go to projects">↓</a></div>
  </section>

  <section id="work" class="work-section shell" aria-labelledby="work-heading">
    <div class="section-heading"><div><p class="eyebrow section-number"><T k="selected" /></p><h2 id="work-heading"><T k="workTitle" /></h2></div><p class="section-intro"><T k="workIntro" /></p></div>
    <div class="work-toolbar"><div class="filters" role="group" aria-label="Фильтр проектов" data-en-aria-label="Filter projects"><button class="filter active" data-filter="all" aria-pressed="true"><T k="all" /><span>{String(projects.length).padStart(2, '0')}</span></button><button class="filter" data-filter="apps" aria-pressed="false"><T k="apps" /><span>{String(projects.filter(p => p.category === 'Приложения').length).padStart(2, '0')}</span></button><button class="filter" data-filter="websites" aria-pressed="false"><T k="websites" /><span>{String(projects.filter(p => p.category === 'Веб-сайты').length).padStart(2, '0')}</span></button></div><span class="mono work-label"><T k="commercial" /></span></div>
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <p class="work-footnote"><T k="workNote" /></p><p class="sr-only" role="status" id="filter-status" aria-live="polite"></p>
  </section>

  <section id="about" class="about-section" aria-labelledby="about-heading"><div class="shell about-grid">
    <div class="about-intro"><p class="eyebrow section-number"><T k="aboutLabel" /></p><h2 id="about-heading"><T k="aboutTitle" /></h2><p><T k="aboutText" /></p><div class="author-signature"><Image src={avatar} alt="Александр Алексеев" data-en-alt="Alexander Alekseev" width={112} height={112} format="webp" loading="lazy" /><span><T k="name" /><small><T k="location" /></small></span></div><div class="experience-stamp"><strong>2015<span>→</span></strong><span><T k="since" /></span></div></div>
    <div class="approach-list">{(['step1', 'step2', 'step3'] as const).map((key, i) => <article><span class="mono">0{i + 1}</span><div><h3><T k={key} /></h3><p><T k={`${key}Text`} /></p></div><span class="approach-icon" aria-hidden="true">{['⌘', '⇄', '↗'][i]}</span></article>)}</div>
  </div></section>

  <section class="stack-section shell" aria-labelledby="stack-heading"><div class="stack-title"><p class="eyebrow section-number"><T k="toolsLabel" /></p><h2 id="stack-heading"><T k="toolsTitle" /></h2></div><div class="stack-table">
    <div><span class="mono"><T k="backendLabel" /></span><h3><T k="backend" /></h3><p>Node.js · TypeScript · Express · NestJS · REST API · WebSocket</p></div>
    <div><span class="mono"><T k="dataLabel" /></span><h3><T k="data" /></h3><p>PostgreSQL · MySQL · Redis · Docker · Linux · Nginx · CI/CD</p></div>
    <div><span class="mono"><T k="mobileLabel" /></span><h3><T k="mobile" /></h3><p>Flutter · Dart · Vue · Nuxt · Capacitor · HTML / CSS</p></div>
  </div></section>

  <section id="lab" class="lab-section shell" aria-labelledby="lab-heading"><div class="section-heading"><div><p class="eyebrow section-number"><T k="labLabel" /></p><h2 id="lab-heading"><T k="labTitle" /></h2></div><p class="section-intro"><T k="labIntro" /></p></div><div class="lab-list">{experiments.map((item, i) => <article><span class="mono lab-number">{item.number}</span><h3><T ru={item.name} en={experimentEnglish[i].name} /><span><T k="pet" /></span></h3><div><p><T ru={item.description} en={experimentEnglish[i].description} /></p><span class="mono lab-tags">{item.tags}</span></div><span class="lab-mark" aria-hidden="true">+</span></article>)}</div><p class="lab-footnote"><T k="labNote" /></p></section>

  <section id="contact" class="contact-section shell" aria-labelledby="contact-heading"><div class="contact-top"><p class="eyebrow"><T k="contactLabel" /></p><span aria-hidden="true">↗</span></div><h2 id="contact-heading"><T k="contactTitle" /></h2><div class="contact-bottom"><a class="button button-dark" href="https://t.me/fckur" target="_blank" rel="noopener noreferrer"><T k="telegram" /><span>↗</span></a><a class="contact-email" href="mailto:desidaraiy@gmail.com">desidaraiy@gmail.com</a><span class="mono"><T k="remote" /></span></div></section>
  <Lightbox />
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const updateStatus = () => {
    const count = [...cards].filter(card => !card.hidden).length;
    const status = document.getElementById('filter-status');
    if (status) status.textContent = document.documentElement.lang === 'en' ? `Projects shown: ${count}` : `Показано проектов: ${count}`;
  };
  filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(filter => { const active = filter === button; filter.classList.toggle('active', active); filter.setAttribute('aria-pressed', String(active)); });
    cards.forEach(card => { card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter; });
    updateStatus();
  }));
  document.addEventListener('portfolio:language', updateStatus);
</script>
