---
import Layout from '../../layouts/Layout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const index = projects.findIndex(item => item.slug === project.slug);
const next = projects[(index + 1) % projects.length];
---
<Layout title={`${project.name} — Александр Алексеев`} description={project.description}>
  <article class="case-page shell">
    <a href={`${base}/#work`} class="back-link">← Все проекты</a>
    <div class="case-heading"><div><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {project.kind}</p><h1>{project.name}<span class="orange">.</span></h1><p class="case-subtitle">{project.subtitle}</p></div><div class="case-type"><span class="status-dot"></span>Коммерческий проект</div></div>
    <ProjectArt project={project} large />
    <p class="case-image-note">{project.image ? 'Реальный экран сайта из локальной сборки.' : 'Схема состава продукта. Реальные экраны будут добавлены в галерею.'}</p>
    <div class="case-body"><aside><p class="eyebrow">О ПРОЕКТЕ</p><ul class="tags">{project.stack.map(tag => <li>{tag}</li>)}</ul></aside><div><h2>Что за продукт</h2><p class="case-context">{project.context}</p><h2 class="case-system-title">Как устроен</h2><div class="case-system">{project.system.map((part, i) => <section><span class="mono">0{i + 1}</span><div><h3>{part.title}</h3><p>{part.text}</p></div></section>)}</div></div></div>
    <a class="next-project" href={`${base}/projects/${next.slug}/`}><span><span class="eyebrow">СЛЕДУЮЩИЙ ПРОЕКТ</span><strong>{next.name}</strong></span><span aria-hidden="true">↗</span></a>
    <div class="case-contact"><p>Обсудим вашу задачу?</p><a class="text-link" href="mailto:desidaraiy@gmail.com">desidaraiy@gmail.com ↗</a></div>
  </article>
</Layout>
