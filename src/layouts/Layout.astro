---
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import T from '../components/T.astro';
import { copy } from '../data/i18n';
interface Props { title?: string; description?: string }
const { title = copy.title[0], description = copy.description[0] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17181b" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(`${base}/images/social.png`, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        let savedLanguage;
        try { savedLanguage = localStorage.getItem('portfolio-language'); } catch {}
        const requested = new URLSearchParams(location.search).get('lang');
        const language = [requested, savedLanguage].find(value => value === 'ru' || value === 'en') || (navigator.language.toLowerCase().startsWith('ru') ? 'ru' : 'en');
        document.documentElement.lang = language;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main"><T k="skip" /></a>
    <header class="site-header shell">
      <a class="brand" href={root} aria-label="Александр Алексеев — главная" data-en-aria-label="Alexander Alekseev — home"><span class="brand-symbol" aria-hidden="true">а<span>а</span><i>.</i></span><span class="brand-name"><T k="brand" /></span></a>
      <nav aria-label="Главная навигация" data-en-aria-label="Main navigation"><a href={`${root}#work`}><T k="projects" /></a><a href={`${root}#about`}><T k="approach" /></a><a href={`${root}#lab`}><T k="personal" /></a></nav>
      <div class="header-actions"><div class="language-switch" role="group" aria-label="Язык / Language"><button type="button" data-language="ru" aria-pressed="true" aria-label="Русский">RU</button><button type="button" data-language="en" aria-pressed="false" aria-label="English">EN</button></div><a class="header-contact" href="mailto:desidaraiy@gmail.com"><T k="discuss" /> <span aria-hidden="true">↗</span></a></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell"><a class="footer-name" href={root}><T k="name" /><span><T k="role" /></span></a><span class="footer-note"><T k="location" /></span><a href="#main"><T k="top" /></a></footer>
    <script>
      import { copy } from '../data/i18n';
      const languageButtons = document.querySelectorAll<HTMLButtonElement>('[data-language]');
      function applyLanguage(language: 'ru' | 'en') {
        document.documentElement.lang = language;
        languageButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.language === language)));
        for (const attribute of ['aria-label', 'alt', 'title']) {
          document.querySelectorAll<HTMLElement>(`[data-en-${attribute}]`).forEach(element => {
            if (!element.hasAttribute(`data-ru-${attribute}`)) element.setAttribute(`data-ru-${attribute}`, element.getAttribute(attribute) ?? '');
            element.setAttribute(attribute, element.getAttribute(`data-${language}-${attribute}`) ?? '');
          });
        }
        const index = language === 'en' ? 1 : 0;
        document.title = copy.title[index];
        document.querySelector('meta[name="description"]')?.setAttribute('content', copy.description[index]);
        document.querySelector('meta[property="og:title"]')?.setAttribute('content', copy.title[index]);
        document.querySelector('meta[property="og:description"]')?.setAttribute('content', copy.description[index]);
        document.querySelector('meta[property="og:locale"]')?.setAttribute('content', language === 'en' ? 'en_US' : 'ru_RU');
        document.querySelector('meta[property="og:locale:alternate"]')?.setAttribute('content', language === 'en' ? 'ru_RU' : 'en_US');
        document.dispatchEvent(new CustomEvent('portfolio:language', { detail: language }));
      }
      applyLanguage(document.documentElement.lang === 'en' ? 'en' : 'ru');
      languageButtons.forEach(button => button.addEventListener('click', () => {
        const language = button.dataset.language === 'en' ? 'en' : 'ru';
        applyLanguage(language);
        try { localStorage.setItem('portfolio-language', language); } catch {}
        const url = new URL(location.href); url.searchParams.set('lang', language); history.replaceState(null, '', url);
      }));
    </script>
  </body>
</html>
